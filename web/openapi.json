{
 "openapi": "3.1.0",
 "info": {
  "title": "killshot",
  "description": "Lineups, win probability and killshots for college basketball.",
  "version": "0.1.0"
 },
 "paths": {
  "/healthz": {
   "get": {
    "summary": "Healthz",
    "description": "Up if the database answers and the worker has checked in within 30 minutes.",
    "operationId": "healthz_healthz_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Health"
        }
       }
      }
     }
    }
   }
  },
  "/api/teams": {
   "get": {
    "summary": "Teams",
    "operationId": "teams_api_teams_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "items": {
          "$ref": "#/components/schemas/Team"
         },
         "type": "array",
         "title": "Response Teams Api Teams Get"
        }
       }
      }
     }
    }
   }
  },
  "/api/teams/{team_id}/games": {
   "get": {
    "summary": "Games",
    "description": "The schedule and results for a season, oldest first. A game that is on shows\nits live score and state, from the live page the worker saves every 30 seconds.",
    "operationId": "games_api_teams__team_id__games_get",
    "parameters": [
     {
      "name": "team_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Team Id"
      }
     },
     {
      "name": "season",
      "in": "query",
      "required": true,
      "schema": {
       "type": "integer",
       "title": "Season"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "$ref": "#/components/schemas/GameSummary"
         },
         "title": "Response Games Api Teams  Team Id  Games Get"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/teams/{team_id}/games/{game_id}": {
   "get": {
    "summary": "Game",
    "description": "One game: best and worst lineups, win probability over time, and killshots.\n\nWhile the game is on (and until CBBD's official record arrives after the\nfinal), this is the live page the worker built from ESPN, with a `live` block.",
    "operationId": "game_api_teams__team_id__games__game_id__get",
    "parameters": [
     {
      "name": "team_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Team Id"
      }
     },
     {
      "name": "game_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Game Id"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/GameDetail"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/teams/{team_id}/seasons/{season}": {
   "get": {
    "summary": "Season",
    "description": "Season totals, lineups with at least `min_minutes` together, and on/off splits.",
    "operationId": "season_api_teams__team_id__seasons__season__get",
    "parameters": [
     {
      "name": "team_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Team Id"
      }
     },
     {
      "name": "season",
      "in": "path",
      "required": true,
      "schema": {
       "type": "integer",
       "title": "Season"
      }
     },
     {
      "name": "min_minutes",
      "in": "query",
      "required": false,
      "schema": {
       "type": "number",
       "default": 20,
       "title": "Min Minutes"
      }
     },
     {
      "name": "exclude_garbage",
      "in": "query",
      "required": false,
      "schema": {
       "type": "boolean",
       "default": false,
       "title": "Exclude Garbage"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Season"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/push/vapid-key": {
   "get": {
    "summary": "Vapid Key",
    "description": "The site's public VAPID key, so the browser can subscribe. None if push isn't set up.",
    "operationId": "vapid_key_api_push_vapid_key_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/VapidKey"
        }
       }
      }
     }
    }
   }
  },
  "/api/push/subscribe": {
   "post": {
    "summary": "Push Subscribe",
    "description": "Save a browser's push subscription. The worker pushes to it when a new killshot shows up.",
    "operationId": "push_subscribe_api_push_subscribe_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/PushSubscription"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Ok"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/push/unsubscribe": {
   "post": {
    "summary": "Push Unsubscribe",
    "operationId": "push_unsubscribe_api_push_unsubscribe_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/PushUnsubscribe"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Ok"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  }
 },
