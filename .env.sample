# Copy to .env (git ignores it) and fill in:   cp .env.sample .env
# Every `killshot` command reads .env from this folder.

# Your local Postgres. `killshot start` creates the database if it doesn't exist yet.
DATABASE_URL=postgresql://localhost:5432/killshot

# A separate database for `killshot test`. The tests wipe it, so never point this at
# DATABASE_URL (killshot test refuses if you do). Created automatically if missing.
TEST_DATABASE_URL=postgresql://localhost:5432/killshot_test

# Your CollegeBasketballData.com API key (collegebasketballdata.com -> your account).
CBBD_API_KEY=

# Teams to follow, as CBBD spells them, comma-separated.
TRACKED_TEAMS=Kansas

# CBBD calls your tier allows per month (Tier 1: 5000, Tier 2: 30000).
CBBD_MONTHLY_LIMIT=5000

# Port for the site.
PORT=8000
