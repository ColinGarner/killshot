# Copy to .env and fill in. .env is ignored by git, so your key stays on your machine.

# Your CollegeBasketballData.com API key (collegebasketballdata.com -> your account).
CBBD_API_KEY=

# Teams to follow, as CBBD spells them, comma-separated.
TRACKED_TEAMS=Kansas

# Calls your CBBD tier allows per month (Tier 1: 5000, Tier 2: 30000).
CBBD_MONTHLY_LIMIT=5000
